# Application Settings
PROJECT_NAME="Extraction Tools Hub"
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase PostgreSQL Database (Optional - falls back to SQLite if not provided)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
DATABASE_URL=postgresql://postgres:yourpassword@db.your-supabase-project-id.supabase.co:5432/postgres

# Upstash Redis / Redis (Optional - falls back to in-memory store if not provided)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_URL=redis://default:yourpassword@your-upstash-instance.upstash.io:6379
